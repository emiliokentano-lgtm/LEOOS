{
  "name": "leoos",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @leoos/web dev",
    "build": "pnpm --filter @leoos/web build",
    "start": "pnpm --filter @leoos/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @leoos/db migrate",
    "db:seed": "pnpm --filter @leoos/db seed",
    "db:seed:demo": "pnpm --filter @leoos/db seed:demo",
    "db:generate": "pnpm --filter @leoos/db generate",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:api": "pnpm --filter @leoos/api dev",
    "dev:web": "pnpm --filter @leoos/web dev"
  }
}
