# Walkthrough output.
#
# Every `apps/web/scripts/*-check.mjs` writes screenshots to a dot-directory, so
# they are listed together rather than one at a time as each was written — which
# is how three of them ended up untracked-but-not-ignored and appearing in
# `git status` after every run.
.visual/
.admin/
.dashboard/
.dispatch/
.live-map/
.notify/
.personnel-check/
.rcheck/
.realtime/
.records/
.search/
.roles/
.fivem/
.session/

# local database state
pgdata/

# Next.js auto-generates these in apps/web on `next dev`. Not committed: an
# apps/web/CLAUDE.md would shadow the project's own engineering rules for any
# agent working in that directory.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# map walkthrough output
.map/
