# The LEOOS API (apps/api).
LEOOS_API_URL=http://localhost:3001

# Where the BROWSER should open the real-time WebSocket.
#
# Resolved server-side and handed to the client with each ticket, rather than
# inlined as a NEXT_PUBLIC_ variable, so the deployment topology stays in one
# place. Left unset it is derived from LEOOS_API_URL with the scheme swapped,
# which is right for local development; behind a proxy, set it explicitly.
# LEOOS_PUBLIC_WS_URL=wss://api.example.com/ws

# Must match INTERNAL_API_TOKEN in apps/api. Identifies the web tier on
# server-to-server calls. Never exposed to the browser.
LEOOS_INTERNAL_API_TOKEN=change-me-at-least-16-chars

# Shows a persistent "Demo data" badge in the shell. Left COMMENTED OUT on
# purpose: this file is meant to be copied, and an example that ships a demo
# flag switched on is an example that puts the badge on somebody's staging
# deployment. Every screen reads real data from the API either way.
# NEXT_PUBLIC_LEOOS_DEMO=1
