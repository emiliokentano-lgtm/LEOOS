NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://leoos:leoos@localhost:5432/leoos

# Origins allowed to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret the web tier presents on internal calls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN=change-me-at-least-16-chars
