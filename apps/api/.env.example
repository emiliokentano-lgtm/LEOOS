NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://leoos:leoos@localhost:5432/leoos

# Origins allowed to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret the web tier presents on internal calls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN=change-me-at-least-16-chars

# ── FiveM ingest ───────────────────────────────────────────────────────────
# Where live unit positions come from: `mock` (simulated) or `fivem` (a real
# game server bridge). Explicit rather than inferred, so "is this map real?" is
# answerable from configuration. In production `mock` is refused outright unless
# ALLOW_MOCK_ADAPTERS=true.
POSITION_SOURCE=mock

# Base64 32-byte key that encrypts game-server ingest secrets at rest.
#
# Required only when POSITION_SOURCE=fivem or when issuing a credential. HMAC is
# symmetric, so the API must be able to READ the secret back — see migration
# 0007 for why this is encryption rather than hashing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LEOOS_FIVEM_SECRET_KEY=
